---
export interface Props {
  src: string;
  stateMachines?: StorageManager;
}

const { src, stateMachines }: Props = Astro.props;

const blogassetsDir = "/assets/blog/";
const isRoot = src.startsWith("/src");

const trueSrc = isRoot ? src : blogassetsDir + src;
---

<canvas
  class="rive-canvas"
  data-rive-src={trueSrc}
  data-rive-state-machines={stateMachines}
  width="100"
  height="100"
>
</canvas>

<style is:global>
  canvas-rive {
    width: 100%;
    height: 100%;
  }
</style>
