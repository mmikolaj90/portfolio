---
export interface Props extends HTMLVideoElement {
  type?: string;
  class?: string;
  root?: boolean;
  playsinline?: boolean;
  webkitPlaysinline?: boolean;
}

const {
  src,
  title = "Video title",
  class: className,
  playsinline = true,
  webkitPlaysinline = true,
  muted = true,
  loop = true,
  type = "video/mp4",
}: Props = Astro.props;

const blogassetsDir = "/assets/blog/";
const isRoot = src.startsWith("/src");

const trueSrc = isRoot ? src : blogassetsDir + src;
---

<video
  class={className}
  muted={muted}
  loop={loop}
  playsinline={playsinline}
  src={trueSrc}
  title={title}
  type={type}
  class={className}
  webkitPlaysinline={webkitPlaysinline}
  {...Astro.props}
/>
