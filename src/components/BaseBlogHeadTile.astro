---
import type { Props as BaseBlogGridTileProps } from "./BaseBlogGridTile.astro";
import BaseBlogGridTile from "./BaseBlogGridTile.astro";

interface Props extends BaseBlogGridTileProps {
  title: string;
  date: string;
  text: string;
  index?: number;
}

const { gridPosition, style, title, date, text, index } = Astro.props;
---

<BaseBlogGridTile
  gridPosition={gridPosition}
  index={index}
  style={style}
>
  <div class="base-blog-head__tile">
    <div class="head">
      <h1 class="title display-1">
        {title}
      </h1>
      <div class="date">{date}</div>
      <slot>
        <div class="text">{text}</div>
      </slot>
    </div>
  </div>
</BaseBlogGridTile>
